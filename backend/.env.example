# ---- StockFlow backend settings ----
PORT=5000

# Local MongoDB (installed on your computer). "stockflow" is the database name;
# MongoDB creates it automatically the first time something is saved.
MONGODB_URI=mongodb://127.0.0.1:27017/stockflow

# If you use MongoDB Atlas (cloud) instead, paste its connection string above, e.g.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stockflow?retryWrites=true&w=majority

# Any long random text. Change this before going live!
JWT_SECRET=put-a-long-random-string-here

# Address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173,http://localhost:5175

# Fill the database with demo products, warehouses, orders … the first time the server starts.
# Set to false if you want to start with an empty database.
SEED_DEMO_DATA=true

# Max login attempts per 15 minutes per IP
LOGIN_RATE_LIMIT=100

# Which demo data to load: leave empty for the larger review dataset (49 products, 5 warehouses, 8 suppliers …),
# or set to "small" for the original 12-product demo.
SEED_DATASET=
